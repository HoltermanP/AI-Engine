# Database (Neon + PostGIS) — optioneel; zonder DATABASE_URL draait de app op demo-data
DATABASE_URL=

# Clerk authenticatie — optioneel; zonder keys draait demo-auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OpenAI (optioneel — chat-assistent in rapportviewer)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (aanbevolen — uitgebreide onderzoeksrapporten)
ANTHROPIC_API_KEY=
# Snel: claude-haiku-4-5-20251001 | Kwaliteit: claude-sonnet-4-6
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Kadaster KLIC (optioneel — PKI-certificaat vereist voor live)
KLIC_USER=
KLIC_API_TOKEN=
KLIC_PKI_CERT_PATH=

# BRK Inzage (optioneel)
BRK_INZAGE_USER=
BRK_INZAGE_PASSWORD=

# Connector modus — false = live PDOK/BRO data (kopieer naar .env.local)
PDOK_FORCE_DEMO=false
BRO_FORCE_DEMO=false
WATERSCHAP_FORCE_DEMO=true

# Extra bodembronnen: landelijk + provinciaal + gemeentelijk + regionaal; bij BRO live standaard all
# all | none | zeeland_bodemregister,limburg_bodemregister,fryslan_bodematlas,nijmegen
VERVUILDE_GROND_EXTRA_SOURCES=all

# Mapillary straatbeeld (optioneel)
MAPILLARY_ACCESS_TOKEN=

# QStash (fase 2) — zonder token: synchrone verwerking
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob (fase 3)
BLOB_READ_WRITE_TOKEN=

# DWG-conversie (optioneel) — externe service die POST met DXF-body accepteert en DWG retourneert
# Licentie-afhankelijke conversie (ODA/Teigha) is bewust niet meegeleverd; alleen het koppelvlak bestaat.
DWG_CONVERTER_URL=
