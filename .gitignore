# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example blijft commitbaar als sjabloon
.env
.env.local
.env.*.local

# vercel
.vercel

# BRO SAD extract (groot bestand, lokaal genereren via npm run data:extract-sad)
/lib/data/bro-sad-vervuilde-grond.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code — lokale instellingen per gebruiker
.claude/settings.local.json
